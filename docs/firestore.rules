rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // ADMIN CONTROL: put YOUR admin Firebase UID here (find it in
    // Firebase Console -> Authentication -> Users). The admin may read
    // every account (to approve / block / set expiry / manage devices)
    // and may edit ONLY the access-control fields of any user.
    // ------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    // Fields only the Admin may change (the kill-switch).
    function onlyAdminFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'expiryDate', 'maxDevices',
                    'registeredDevices', 'updatedAt']);
    }

    // ------------------------------------------------------------------
    // SELF-SERVE ACTIVATION: the remote `auto_approve` flag (config/app,
    // docs/REMOTE_CONTROL.md) lets brand-new accounts go live without a
    // manual admin step. It defaults to ON while the config document or
    // field is missing; the Admin can turn it off any time by creating
    // config/app with auto_approve = false.
    // ------------------------------------------------------------------
    function isAutoApproveOn() {
      return !exists(/databases/$(database)/documents/config/app)
          || get(/databases/$(database)/documents/config/app)
                .data.get('auto_approve', true) == true;
    }

    // Account record for every shop owner. The owner can read their own
    // account (needed offline for the access check) but can NEVER flip
    // their own status/expiry - that is the whole point of the
    // admin approval + kill-switch system.
    match /users/{userId} {
      allow get, list: if request.auth != null
                         && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.maxDevices == 2
                      && (request.resource.data.status == 'pending'
                          || (request.resource.data.status == 'active'
                              && isAutoApproveOn()));
      // Owner may only touch their own PIN hash / profile fields;
      // status, expiryDate, maxDevices and registeredDevices are
      // admin-controlled (plus the automatic device self-registration).
      allow update: if request.auth != null && (
                        (request.auth.uid == userId
                         && onlyAdminFieldsChanged()
                         && request.resource.data.status == resource.data.status
                         && request.resource.data.expiryDate == resource.data.expiryDate)
                        || isAdmin()
                        || (request.auth.uid == userId
                            // self device registration within the limit
                            && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['registeredDevices'])
                            && request.resource.data.registeredDevices.size()
                                  <= request.resource.data.maxDevices)
                        || (request.auth.uid == userId
                            // self-activation: the ONLY status change an
                            // owner may make - pending -> active - and
                            // only while the remote auto_approve flag is on
                            && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['status', 'updatedAt'])
                            && resource.data.status == 'pending'
                            && request.resource.data.status == 'active'
                            && isAutoApproveOn())
                      );
      allow delete: if isAdmin();
    }

    // Each shop gets a document tree under shops/{uid}. Only the
    // authenticated owner of that uid can read/write its own shop data.
    match /shops/{shopId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == shopId;
    }

    // ------------------------------------------------------------------
    // REMOTE FEATURE FLAGS (WhatsApp-style behaviour changes without an
    // APK update). config/app holds `notice`, `min_version` and a
    // `features` map - no private data, so every client may read it (even
    // before sign-in). Only the Admin may edit it; the Firebase Console
    // always bypasses these rules for the document editor.
    // ------------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
