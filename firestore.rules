rules_version = '2';

// =====================================================================
// Ruby Invoice - Firestore security rules (v2, spec-compliant)
//
// Models:
//   users/{uid}                     -> account + plan + device list
//   users/{uid} ... profile fields  -> owner-editable ONLY these
//   shops/{uid}/{document=**}       -> private billing data (sync)
//   shops/{uid}/photos/{photoKey}   -> photo URL markers (Storage sync)
//   subscriptions/{subId}           -> Razorpay-ready subscription ledger
//   config/{docId}                  -> remote feature flags (public read)
//
// Admin = the whitelisted OWNER Gmail (Ruby Key panel / Firebase
// console). Everyone else can only ever touch their OWN account.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- admin (whitelist by Gmail) --------------------
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'ahemadjuneja@gmail.com';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Data access (bills, customers, photos) only while ACTIVE - a
    // blocked or expired account loses cloud access automatically.
    // The device-id part of the limit lives in the app (AccessService);
    // rules below make sure an unknown device cannot even sign in to
    // reach that check.
    function isActiveOwner(uid) {
      return isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    // ---------------- SELF-SERVE ACTIVATION -------------------------
    // The remote `auto_approve` flag (config/app) lets brand-new
    // accounts go live without a manual admin step. Defaults ON while
    // the doc/field is missing.
    function isAutoApproveOn() {
      return !exists(/databases/$(database)/documents/config/app)
          || get(/databases/$(database)/documents/config/app)
                .data.get('auto_approve', true) == true;
    }

    // ----------------------------------------------------------------
    // users/{uid} - the account record
    // ----------------------------------------------------------------
    match /users/{userId} {
      allow get, list: if request.auth != null
                         && (isOwner(userId) || isAdmin());

      // Registration (new Gmail): the app creates the doc itself with
      // plan "trial", 7-day trial window and maxDevices 2.
      allow create: if request.auth != null
                      && isOwner(userId)
                      && request.resource.data.maxDevices == 2
                      && request.resource.data.plan == 'trial'
                      && (request.resource.data.status == 'pending'
                          || (request.resource.data.status == 'active'
                              && isAutoApproveOn()));

      // Updates:
      //  * admin (Ruby Key): anything - status / plan / validity /
      //    maxDevices / device reset (the kill switch).
      //  * owner: ONLY profile fields (business name, owner, mobile,
      //    city, address, gst, PIN) - never status / plan / validity.
      //  * owner: self device registration or removal within the 2
      //    device limit (registeredDevices + deviceModels together).
      //  * owner: self-activation pending -> active while auto_approve.
      allow update: if request.auth != null && (
          isAdmin()
          || (isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['businessName', 'ownerName', 'mobile', 'phone',
                              'city', 'address', 'gst', 'pinHash', 'pinSalt',
                              'updatedAt']))
          || (isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['registeredDevices', 'deviceModels', 'updatedAt'])
              && request.resource.data.registeredDevices.size()
                    <= request.resource.data.maxDevices)
          || (isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'updatedAt'])
              && resource.data.status == 'pending'
              && request.resource.data.status == 'active'
              && isAutoApproveOn())
      );

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // shops/{uid}/... - private billing data + photo markers
    // Isolation: only the owner; only while the account is active.
    // ----------------------------------------------------------------
    match /shops/{shopId}/{document=**} {
      allow read, write: if isActiveOwner(shopId);
    }

    // ----------------------------------------------------------------
    // subscriptions - Razorpay-ready schema (Razorpay webhook will
    // write the same shape later using the server SDK):
    //   { userId, planId, amount, currency, razorpayOrderId,
    //     razorpayPaymentId, status, validUntil, note, createdAt }
    // ----------------------------------------------------------------
    match /subscriptions/{subId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------
    // config/{docId} - remote feature flags (no private data).
    // ----------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
